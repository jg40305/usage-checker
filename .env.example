# 複製成 .env 後填入。.env 已列在 .gitignore，不會進 git。

# 你的私人 Discord 伺服器 ID（設定後斜線指令會立即出現）
DISCORD_GUILD_ID=
# 允許使用 bot 的 Discord 使用者 ID，多個用逗號分隔
DISCORD_ALLOWED_USER_IDS=

# ---- Claude bot ----
CLAUDE_BOT_TOKEN=
# 重置通知要發到的頻道 ID（留空則不發通知）
CLAUDE_NOTIFY_CHANNEL_ID=
# 快取超過幾小時標示為「可能已過期」
CLAUDE_STALE_HOURS=6
# 選用：Anthropic API 花費（sk-ant-admin...，權限很大，不需要就留空）
ANTHROPIC_ADMIN_KEY=

# ---- Codex bot ----
CODEX_BOT_TOKEN=
CODEX_NOTIFY_CHANNEL_ID=
# 每幾分鐘查一次 Codex 額度（用來安排重置通知、偵測登入失效）
CODEX_POLL_MINUTES=30
# 選用：OpenAI API 花費（sk-admin-...，不需要就留空）
OPENAI_ADMIN_KEY=

# 進階：通常不用設定
# CODEX_BIN=
# CLAUDE_CACHE_PATH=
