# 複製成 .env 後填入。.env 已列在 .gitignore，不會進 git。

# Discord bot token（只需要一個 bot）
DISCORD_BOT_TOKEN=
# 你的私人 Discord 伺服器 ID（設定後斜線指令會立即出現）
DISCORD_GUILD_ID=
# 選填：允許使用 /usage 的 Discord 使用者 ID，多個用逗號分隔。留空 = DISCORD_GUILD_ID 伺服器裡的人都能用
DISCORD_ALLOWED_USER_IDS=
# 通知方式：channel（頻道）/ dm（私訊給 DISCORD_ALLOWED_USER_IDS 的人）/ both
NOTIFY_MODE=channel
# 定時回報、重置通知要發到的頻道 ID（NOTIFY_MODE 含 channel 時需要）
NOTIFY_CHANNEL_ID=
# 超過幾分鐘沒有手動 /usage，就自動發一次用量（0 = 關閉）
AUTO_REPORT_MINUTES=60
# 5 小時／每週額度重置前幾分鐘發提醒（0 = 關閉）
REMINDER_MINUTES=60

# 每幾分鐘用 claude /usage 查一次 Claude 額度（不消耗額度）
CLAUDE_POLL_MINUTES=5
# claude /usage 失敗、改用狀態列快取時，快取超過幾小時標示為「可能已過期」
CLAUDE_STALE_HOURS=6
# 每幾分鐘查一次 Codex 額度（用來安排重置通知、偵測登入失效）
CODEX_POLL_MINUTES=30

# 選用：API 花費。權限很大，不需要就留空
# ANTHROPIC_ADMIN_KEY=sk-ant-admin...
ANTHROPIC_ADMIN_KEY=
# OPENAI_ADMIN_KEY=sk-admin-...
OPENAI_ADMIN_KEY=
